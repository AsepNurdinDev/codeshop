# Copy this file to .env for local `go run ./cmd/server` development.
# .env is loaded automatically (see cmd/server/main.go) and is git-ignored.
# In Docker Compose / Kubernetes, real environment variables are injected
# instead and this file is not used.

APP_ENV=development
SERVICE_NAME=auth-service

HTTP_PORT=8080
GRPC_PORT=9090

DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_db?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONN_TIMEOUT=5s

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=codeshop.events

# WARNING: change this in any shared/production environment. Auth Service
# refuses to start with an empty JWT_SECRET when APP_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW=15m
