# Application Environment
ENVIRONMENT=development
LOG_LEVEL=info
SERVER_PORT=8081
GRPC_PORT=50051

# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/codeshop_auth?sslmode=disable

# Redis Cache & Session Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Authentication Secrets
JWT_SECRET=super-secret-jwt-key-codeshop-production-auth-do-not-share
JWT_ISSUER=codeshop-auth-service
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=168h
